# release 签名配置模板（复制为 keystore.properties 后填入真实值；keystore.properties 不入库）
# 依据 DOCS/《拼豆》手机端应用开发经验总结.md §2.3：含本机路径/密钥的配置，第一天就做成"模板文件 + 容错读取"。
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore android/jiyi-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias jiyi -storepass <你的密码> -keypass <你的密码> \
#           -dname "CN=JiYi, OU=Dev, O=JiYi, L=Unknown, ST=Unknown, C=CN"
#
# ⚠️ 密钥库与密码一旦丢失，应用将无法再更新（商店不接受换签名的同名应用），请自行备份。
# 路径以 app 模块为基准（本文件在 android/ 下，故向上退一级）
storeFile=../jiyi-release.jks
storePassword=
keyAlias=jiyi
keyPassword=
