{
  "name": "jiyi",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "稽疑 JiYi - 多品类易学/国学工具（纯前端离线）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:sync": "node scripts/sync-content.mjs",
    "verify": "npm run typecheck && npm run test && npm run content:sync",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "cd android && gradlew assembleDebug",
    "android:release": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lunar-typescript": "^1.8.6",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "lunisolar": "^2.6.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
